# 只上传作品（berkson、luanjiyuan……）和 skills/
# 试拍和上游 skill 的参考克隆不进仓库
/threebody3d/
/vibe-knowledge-film/
# 第三方 skill（xilo-opus-video、huashu-art-motion、lemo-opuscar）和参考库（mg-styles-15）
# 我们自己写的项目 skill 要进仓库，逐个放行
/.claude/skills/*
!/.claude/skills/viber-studio/
/refs/

# 依赖
node_modules/
__pycache__/
*.pyc

# 渲染中间产物：每次渲染都会覆盖。定稿另存到 <作品>/versions/vN.mp4
renders/
review/
**/audio/*.wav
# 预览页、风格样片页的字体是作品 fonts/ 的副本；样片小样随时能重渲，只留拼图
**/previews/*/fonts/
**/styles/*/fonts/
**/styles/*.mp4
**/styles/*/*.mp4
**/previews/*.mp4
**/previews/*/*.mp4

# 杂项
_*.txt
Thumbs.db
desktop.ini
.DS_Store
